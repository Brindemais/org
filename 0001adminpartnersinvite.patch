+    setForm({ company_name: '', trade_name: '', category: 'bar', whatsapp: '', address: '', neighborhood: '', email: '' })
+    if (created.email) {
+      setCreateMsg('Parceiro cadastrado! Enviando convite de acesso por e-mail...')
